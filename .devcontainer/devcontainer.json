{
  "name": "Minimal Ubuntu + Docker",
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "installDockerBuildx": false,
      "installDockerComposeSwitch": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "bradgashler.htmltagwrap"
      ]
    }
  },
  "runArgs": [
    "--privileged"
  ],
  "remoteUser": "root"
}
